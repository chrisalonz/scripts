    TabActiveIndicator.Size = UDim2.new(0, 3, 0.65, 0)
    TabActiveIndicator.Position = UDim2.new(0, 3, 0.175, 0)
    TabActiveIndicator.BackgroundColor3 = Theme.Accent
    TabActiveIndicator.BorderSizePixel = 0
    TabActiveIndicator.BackgroundTransparency = 1
    TabActiveIndicator.Parent = TabBtn

    TabFrames[tabName] = Page
    TabButtons[tabName] = { Btn = TabBtn, Indicator = TabActiveIndicator }

    trackConnect(TabBtn.Activated, function()
        for name, p in pairs(TabFrames) do
            p.Visible = (name == tabName)
