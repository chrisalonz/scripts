        task.wait(Settings.CutDelay or 0.03)
        if _G.__CELLULAR_ACTIVE_SESSION ~= CURRENT_SESSION then break end

        if Settings.MasterAutoFarm then
            local cust = getSeatedCustomer()
            local isActivelyCutting = false

            if Settings.AutoCutHair and cust and cust.Parent then
                local og = cust:FindFirstChild("Overgrowth")
                local chunks = og and og:GetChildren()
                if chunks and #chunks > 0 then
                    isActivelyCutting = true
                    local damageFunc = getDamageChunkFunc()
                    if damageFunc then
                        -- Shave all hair chunks across the model smoothly
                        for _, ch in ipairs(chunks) do
                            if ch and ch.Parent then
                                pcall(damageFunc, ch)
                            end
                        end
                    end
                end
            end

            -- Seating logic when chair is not actively cutting
            if Settings.AutoSeatCustomer and not isActivelyCutting then
                local lineCount = LocalPlayer:GetAttribute("LineCount") or 0
                if lineCount > 0 then
                    local chairCF = HAIR_KIT and HAIR_KIT.originCF and HAIR_KIT.originCF()
                    local root = Character and Character:FindFirstChild("HumanoidRootPart")
                    if chairCF and root and (chairCF.Position - root.Position).Magnitude > 12 then
