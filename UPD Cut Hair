local ESPObjects = {}
local function removeESP(id)
    if ESPObjects[id] then
        pcall(function()
            if ESPObjects[id].Highlight then ESPObjects[id].Highlight:Destroy() end
            if ESPObjects[id].Billboard then ESPObjects[id].Billboard:Destroy() end
        end)
        ESPObjects[id] = nil
    end
end

local function updateESP()
    local myRoot = Character and Character.PrimaryPart
    if not myRoot then return end

    if Settings.PlayerESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character.PrimaryPart then
                local id = "Player_" .. p.UserId
                local dist = math.floor((p.Character.PrimaryPart.Position - myRoot.Position).Magnitude)
                if not ESPObjects[id] then
                    local hl = Instance.new("Highlight")
                    hl.Adornee = p.Character
                    hl.FillColor = Theme.Accent
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Parent = TargetGuiParent

                    local bb = Instance.new("BillboardGui")
                    bb.Adornee = p.Character.PrimaryPart
                    bb.Size = UDim2.new(0, 140, 0, 30)
                    bb.StudsOffset = Vector3.new(0, 3, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = TargetGuiParent

                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.TextColor3 = Theme.AccentLight
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 10
                    lbl.Parent = bb

                    ESPObjects[id] = { Highlight = hl, Billboard = bb, Label = lbl }
                end
                if ESPObjects[id] then
                    ESPObjects[id].Label.Text = string.format("%s [%dm]", p.DisplayName, dist)
                end
            else
                removeESP("Player_" .. p.UserId)
            end
        end
    else
        for id in pairs(ESPObjects) do
            if id:find("Player_") then removeESP(id) end
        end
    end
end

