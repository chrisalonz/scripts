                    end

                    if HAIR_KIT and HAIR_KIT.RequestSeat then
                        pcall(function() HAIR_KIT.RequestSeat:Fire(true) end)
                    elseif SEAT_REMOTE then
                        pcall(function() SEAT_REMOTE:FireServer(false) end)
                    end
                else
                    if Settings.AutoRecruitStreet and not isRecruitingInProgress then
                        recruitStreetCustomer()
                    end
                end
            end
        end
    end
end)

