        for name, item in pairs(TabButtons) do
            local isSel = (name == tabName)
            item.Btn.BackgroundColor3 = isSel and Theme.BgCardHighlight or Theme.BgSidebar
            item.Btn.TextColor3 = isSel and Theme.TextPrimary or Theme.TextSecondary
            item.Btn.Font = isSel and Enum.Font.GothamBold or Enum.Font.GothamMedium
            item.Indicator.BackgroundTransparency = isSel and 0 or 1
        end
    end)

    return Page
end

