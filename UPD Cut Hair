local function getPlayerPower()
    local attr = LocalPlayer:GetAttribute("ToolPower") or LocalPlayer:GetAttribute("Power") or LocalPlayer:GetAttribute("ToolDamage")
    if attr and tonumber(attr) then return tonumber(attr) end
    local lead = LocalPlayer:FindFirstChild("leaderstats")
    local pStat = lead and (lead:FindFirstChild("Power") or lead:FindFirstChild("Damage"))
    if pStat and tonumber(pStat.Value) then return tonumber(pStat.Value) end
    return 1
end

-- Teleport character cleanly to the barber stance at salon chair
local function goToChair()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and not root.Anchored and HAIR_KIT and HAIR_KIT.originCF then
        local ok, v1 = pcall(HAIR_KIT.originCF)
        if ok and v1 then
            local v2 = Vector3.new(v1.LookVector.X, 0, v1.LookVector.Z)
            local standPos = v1.Position - (0.05 < v2.Magnitude and v2.Unit or Vector3.new(0, 0, -1)) * 5 + Vector3.new(0, 3, 0)
            char:PivotTo(CFrame.lookAt(standPos, Vector3.new(v1.Position.X, standPos.Y, v1.Position.Z)))
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end

-- Find currently seated customer at salon chair
local function getSeatedCustomer()
    if HAIR_KIT and HAIR_KIT.chairCustomer then
        local ok, cust = pcall(HAIR_KIT.chairCustomer)
        if ok and cust and cust.Parent then
            return cust
        end
    end

    local chairCF = nil
    if HAIR_KIT and HAIR_KIT.originCF then
        local ok, cf = pcall(HAIR_KIT.originCF)
        if ok and cf then chairCF = cf end
    end
    if not chairCF then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then chairCF = root.CFrame end
    end
    if not chairCF then return nil end

    for _, m in ipairs(Workspace:GetChildren()) do
        if m:IsA("Model") and m ~= LocalPlayer.Character and m:FindFirstChild("Overgrowth") then
            local head = m:FindFirstChild("Head") or m.PrimaryPart
            if head and (head.Position - chairCF.Position).Magnitude <= 14 then
                return m
            end
        end
    end
    return nil
end

-- Check if street customer is viable (>= 50% power threshold so recruit never fails)
local function isStreetCandidateViable(npcModel)
    if not npcModel or not npcModel.Parent then return false, 0 end
    local prompt = npcModel:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt or not prompt.Enabled then return false, 0 end

    local actionText = prompt.ActionText or ""
    local pctStr = actionText:match("%((%d+)%%%)")
    if pctStr then
        local pct = tonumber(pctStr) or 0
        -- Skip if below 50% success chance to prevent recruit failures
        if pct < 50 then return false, pct end
        return true, pct
    end

    if actionText:lower():find("recruit") then
        return true, 100
    end

    local myPower = getPlayerPower()
    local reqPower = 1
    if RARITY_KIT and RARITY_KIT.oddsOf and RARITY_KIT.powerNeeded then
        local odds = RARITY_KIT.oddsOf(npcModel)
        local need = RARITY_KIT.powerNeeded(npcModel, odds)
        if need and tonumber(need) then reqPower = tonumber(need) end
    end
    local ratio = myPower / math.max(1, reqPower)
    if ratio >= 0.50 then
        return true, math.floor(math.min(100, ratio * 100))
    end
    return false, 0
end

-- Active Street Customer Recruiter Routine
local isRecruitingInProgress = false
local function recruitStreetCustomer()
    if isRecruitingInProgress then return end
    if not Settings.MasterAutoFarm or not Settings.AutoRecruitStreet then return end

    local lineCount = LocalPlayer:GetAttribute("LineCount") or 0
    local maxLine = LocalPlayer:GetAttribute("MaxLine") or 6
    if lineCount >= maxLine then return end

    isRecruitingInProgress = true
    pcall(function()
        local tagged = CollectionService:GetTagged("STREET_CUSTOMER")
        local bestCandidate = nil
        local bestChance = -1

        for _, npc in ipairs(tagged) do
            local viable, chance = isStreetCandidateViable(npc)
            if viable and chance > bestChance then
                bestChance = chance
                bestCandidate = npc
            end
        end

        if bestCandidate and bestCandidate.Parent then
            local prompt = bestCandidate:FindFirstChildWhichIsA("ProximityPrompt", true)
            local head = bestCandidate:FindFirstChild("Head") or bestCandidate.PrimaryPart
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if prompt and head and root then
                char:PivotTo(head.CFrame + Vector3.new(0, 2, 3))
                task.wait(0.12)
                pcall(function() fireproximityprompt(prompt) end)
                task.wait(0.2)
                goToChair()
            end
        end
    end)
    isRecruitingInProgress = false
end

