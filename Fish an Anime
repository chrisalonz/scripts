    local function GetUnlockedNonRobuxStandsCount()
        local lp = game:GetService("Players").LocalPlayer
        if not lp then return nil end
        local plotName = lp:GetAttribute("PlotName")
        local plots = workspace:FindFirstChild("PlayerPlots")
        local myPlot = nil
        if plots and plotName then
            myPlot = plots:FindFirstChild(plotName)
        end
        if not myPlot and plots then
            for _, p in ipairs(plots:GetChildren()) do
                if p:GetAttribute("OwnerUserId") == lp.UserId or p:GetAttribute("OwnerName") == lp.Name then
                    myPlot = p
                    break
                end
            end
        end
        if not myPlot then return nil end

        local purchases = myPlot:FindFirstChild("Purchases")
        if not purchases then return nil end

        local count = 0
        for _, stand in ipairs(purchases:GetChildren()) do
            local hasCharAttr = stand:GetAttribute("HasCharacter") ~= nil
            local hasLevelPrompt = stand:FindFirstChild("LevelUpPrompt", true) ~= nil 
                or stand:FindFirstChild("MaxLevelUpPrompt", true) ~= nil
                or stand:FindFirstChild("LevelUp10Prompt", true) ~= nil
            local isStand = hasCharAttr or hasLevelPrompt or stand.Name:lower():find("stand")

            if isStand then
                local isLocked = stand:GetAttribute("Locked") == true 
                    or stand:GetAttribute("Unlocked") == false 
                    or stand:GetAttribute("Purchased") == false
                    or stand:GetAttribute("RequiresRobux") == true
                    or stand:GetAttribute("IsRobux") == true
                    or stand:GetAttribute("Robux") == true
                    or stand:GetAttribute("RobuxCost") ~= nil
                    or stand:GetAttribute("DevProductId") ~= nil
                    or stand:GetAttribute("GamepassId") ~= nil

                local hasRobuxPrompt = false
                for _, desc in ipairs(stand:GetDescendants()) do
                    if desc:IsA("ProximityPrompt") then
                        local act = (desc.ActionText or ""):lower()
                        local obj = (desc.ObjectText or ""):lower()
                        if act:find("robux") or act:find("r%$") or act:find("unlock") or act:find("buy") or act:find("purchase")
                            or obj:find("robux") or obj:find("r%$") or obj:find("unlock") or obj:find("buy") or obj:find("purchase") then
                            if not act:find("level") and not obj:find("level") then
                                hasRobuxPrompt = true
                                break
                            end
                        end
                    elseif desc:IsA("TextLabel") and desc.Visible then
                        local t = (desc.Text or ""):lower()
                        if t:find("r%$") or t:find("robux") or t:find("locked") or t:find("purchase stand") then
                            hasRobuxPrompt = true
                            break
                        end
                    end
                end

                if not isLocked and not hasRobuxPrompt then
                    count = count + 1
                end
            end
        end

        return count > 0 and count or nil
    end

    local function RunImprovedPlaceBest()
        if not (BackpackGetEquippedState and BackpackEquipCharacter and BackpackUnequipCharacter) then
            if BackpackEquipBest then BackpackEquipBest:FireServer() end
            return
        end

        local okState, state = pcall(function() return BackpackGetEquippedState:InvokeServer() end)
        local maxStands = (okState and state and type(state.max) == "number") and state.max or 2

        -- Pastikan slot Robux (+1) tidak dihitung jika player belum membelinya
        if okState and state and state.hasPlusOne == false then
            if state.baseMax and type(state.baseMax) == "number" then
                maxStands = math.min(maxStands, state.baseMax)
            end
        end

        -- Validasi ketat: jangan pernah menaruh di plot/stand yang belum terbuka atau butuh Robux
        local verifiedPlotStands = GetUnlockedNonRobuxStandsCount()
        if verifiedPlotStands and verifiedPlotStands > 0 then
            maxStands = math.min(maxStands, verifiedPlotStands)
        end

        local renv = (getrenv and getrenv()) or {}
        local summary = (renv._G and renv._G.__BP_CharSummary)
        if not summary and BackpackCharSummaryGet then
            local okSum, sum = pcall(function() return BackpackCharSummaryGet:InvokeServer() end)
            if okSum then summary = sum end
        end
        if not summary then return end

        local candidates = {}
        for key, data in pairs(summary) do
            if type(data) == "table" and data.ra then
                table.insert(candidates, {
                    key = key,
                    name = data.n or "",
                    rarity = tostring(data.ra or ""),
                    mutation = tostring(data.ty or ""),
                    baseCash = tonumber(data.bc) or 0,
                    count = tonumber(data.c) or 1
                })
            end
        end
        if #candidates == 0 then return end

        local mode = Settings.PlaceBestMode or "Money (CPS)"
        if mode == "Rarity & Mutation" then
            table.sort(candidates, function(a, b)
                local sA = (PlaceBestRarityRanks[a.rarity] or 1) * (PlaceBestMutationMults[a.mutation] or 1)
                local sB = (PlaceBestRarityRanks[b.rarity] or 1) * (PlaceBestMutationMults[b.mutation] or 1)
                if sA ~= sB then
                    return sA > sB
                end
                return a.baseCash > b.baseCash
            end)
        else
            table.sort(candidates, function(a, b)
                return a.baseCash > b.baseCash
            end)
        end

        if okState and state and state.equipped then
            for _, eq in ipairs(state.equipped) do
                if eq.key then
                    pcall(function() BackpackUnequipCharacter:FireServer(eq.key) end)
                end
            end
            task.wait(0.2)
        end

        local toEquip = {}
        for _, cand in ipairs(candidates) do
            local available = cand.count or 1
            while available > 0 and #toEquip < maxStands do
                table.insert(toEquip, cand.key)
                available = available - 1
            end
            if #toEquip >= maxStands then break end
        end

        for _, key in ipairs(toEquip) do
            pcall(function() BackpackEquipCharacter:FireServer(key) end)
            task.wait(0.12)
        end
    end

