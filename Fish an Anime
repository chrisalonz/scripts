SwitchUIStyle = function(targetStyle)
    if targetStyle == "Wind UI" or targetStyle == "Classic" or targetStyle == "Classic (WindUI)" then
        Settings.UIStyle = "Wind UI"
    elseif targetStyle == "Modern Hub" or targetStyle == "Modern" or targetStyle == "Modern (Cellular HUB 2-Tier)" or targetStyle == "Modern (SONN-HUB 2-Tier)" then
        Settings.UIStyle = "Modern Hub"
    elseif targetStyle == "Wallpaper Hub" or targetStyle == "Custom Image Hub" then
        Settings.UIStyle = "Wallpaper Hub"
    else
        Settings.UIStyle = "Modern Hub V2"
    end
    RequestAutoSave()

    pcall(function()
        if ModernGui and ModernGui.Parent then
            ModernGui:Destroy()
            ModernGui = nil
        end
    end)
    pcall(function()
        local target = CoreGui:FindFirstChild("RobloxGui") or CoreGui
        for _, c in ipairs(target:GetChildren()) do
            if c.Name:find("WindUI") or c.Name:find("CELLULAR_HUB") or c.Name:find("SONN_HUB") then c:Destroy() end
        end
    end)

    if Settings.UIStyle == "Wind UI" then
        BuildClassicUI()
    else
        BuildModernUI()
    end
end

