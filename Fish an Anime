        local plotName = lp:GetAttribute("PlotName") or "Plot9"
        local plots = workspace:FindFirstChild("PlayerPlots")
        local myPlot = plots and plots:FindFirstChild(plotName)
        if not myPlot then
            for _, p in ipairs(plots:GetChildren()) do
                if p:GetAttribute("OwnerUserId") == lp.UserId or p:GetAttribute("OwnerName") == lp.Name then
                    myPlot = p
                    break
                end
            end
        end
        if not myPlot or not myPlot:FindFirstChild("Purchases") then return end
        
        local targetRarities = {}
        for _, r in ipairs(Settings.SelectedFeedRarities or {}) do
            targetRarities[r] = true
        end
        
        local oldCF = hrp.CFrame
        local method = Settings.FeedMethod or "Max Level Up"
        local standsToFeed = {}

        for _, stand in ipairs(myPlot.Purchases:GetChildren()) do
            if stand:GetAttribute("HasCharacter") == true then
                local r = stand:GetAttribute("Rarity")
                if targetRarities[r] then
                    local promptName = (method == "Max Level Up" and "MaxLevelUpPrompt")
                        or (method == "Level Up 10" and "LevelUp10Prompt")
                        or "LevelUpPrompt"
                    local prompt = stand:FindFirstChild(promptName, true) or stand:FindFirstChild("LevelUpPrompt", true)
                    if prompt then
                        table.insert(standsToFeed, {stand = stand, prompt = prompt})
