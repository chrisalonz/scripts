local function ApplyCustomBackground(urlOrId, notifySuccess)
    if not urlOrId or urlOrId == "" then return end
    task.spawn(function()
        local raw = tostring(urlOrId):gsub("^%s+", ""):gsub("%s+$", "")
        local asset = ""
        if raw:match("^%d+$") then
            asset = "rbxassetid://" .. raw
        elseif raw:find("rbxassetid://") or raw:find("roblox.com") or raw:find("rbxasset://") then
            asset = raw
        elseif raw:find("^https?://") then
            local req = request or http_request or (syn and syn.request) or (http and http.request)
            if req and writefile and getcustomasset then
                local ok, res = pcall(function()
                    return req({ Url = raw, Method = "GET" })
                end)
                if ok and res and (res.StatusCode == 200 or res.Status == 200) and res.Body then
                    local ext = raw:find("%.png") and ".png" or (raw:find("%.jpe?g") and ".jpg" or ".png")
                    local fname = "Cellular_HUB_CustomBg" .. ext
                    pcall(writefile, fname, res.Body)
                    asset = getcustomasset(fname)
                end
            end
        end
        if asset ~= "" then
            CurrentLoadedBgAsset = asset
            Settings.CustomBackgroundURL = raw
            RequestAutoSave()
            if MainBgImageRef and MainBgImageRef.Parent then
                MainBgImageRef.Image = asset
                MainBgImageRef.Visible = true
            end
            if notifySuccess then
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Cellular HUB Background",
                        Text = "Gambar background kustom berhasil diterapkan!",
                        Duration = 3,
                    })
                end)
                if WindUI then
                    pcall(function()
                        WindUI:Notify({
                            Title = "Background Diperbarui",
                            Content = "Gambar background kustom berhasil diterapkan!",
                        })
                    end)
                end
            end
        end
    end)
end

