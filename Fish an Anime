local function isHeavenCollideActive()
    -- 1. Check cached TrackerData
    if TrackerData and TrackerData.TypeEvent and TrackerData.TypeEvent.active then
        local name = string.lower(tostring(TrackerData.TypeEvent.eventName or ""))
        local title = string.lower(tostring(TrackerData.TypeEvent.eventTitle or ""))
        if name:find("heaven") or title:find("heaven") or title:find("collide") then
            return true
        end
    end
    if TrackerData and TrackerData.LastTypeEventName then
        local last = string.lower(tostring(TrackerData.LastTypeEventName))
        if last:find("heaven") or last:find("collide") then
            return true
        end
    end

    -- 2. Direct check from server remote GetTypeEventState
    local ok, state = pcall(function() return GetTypeEventState:InvokeServer() end)
    if ok and state and type(state) == "table" and state.active then
        local name = string.lower(tostring(state.eventName or ""))
        local title = string.lower(tostring(state.eventTitle or ""))
        if name:find("heaven") or title:find("heaven") or title:find("collide") then
            TrackerData.TypeEvent = state
            return true
        end
    end

    -- 3. Check Workspace WorldEvents or screen text
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, desc in ipairs(playerGui:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Visible then
                local txt = string.lower(desc.Text)
                if txt:find("heaven's collide") or txt:find("heavens collide") then
                    return true
                end
            end
        end
    end

    return false
end

