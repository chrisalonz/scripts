local function disableHeavyVisualEffect(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
        v.Enabled = false
    elseif v:IsA("Beam") then
        v.Enabled = false
    elseif v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
        v.Enabled = false
    elseif v:IsA("Highlight") then
        v.Enabled = false
    elseif v:IsA("BasePart") then
        v.CastShadow = false
    end

    -- Menghilangkan sinar & efek karakter / plot aura secara mendalam
    local name = string.lower(v.Name)
    if name:find("aura") or name:find("wing") or name:find("burst") or name:find("wave") or name:find("shine") or name:find("glow") or name:find("light") then
        if v:IsA("ParticleEmitter") or v:IsA("Beam") or v:IsA("Trail") or v:IsA("Light") or v:IsA("Highlight") then
            v.Enabled = false
        elseif v:IsA("BasePart") or v:IsA("MeshPart") then
            v.Transparency = 1
            v.CastShadow = false
        end
    end
end

