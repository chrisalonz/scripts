local _MonitorCache = {
    Boosts = nil, BoostsTime = 0,
    Selene = nil, SeleneTime = 0,
    Angelia = nil, AngeliaTime = 0,
    Yang = nil, YangTime = 0,
    Sasha = nil, SashaTime = 0,
    Event = nil, EventTime = 0
}

local function cleanHtmlText(text)
    if not text or text == "" then return "" end
    local clean = tostring(text):gsub("<[^>]+>", "")
    clean = clean:gsub("%s*/%s*", " / ")
    clean = clean:gsub("%s+", " ")
    return clean:match("^%s*(.-)%s*$") or clean
end

local function safeUpdateMonitor(key, title, desc)
    local item = UIReferences[key]
    if not item then return end
    if title and item.SetTitle then
        pcall(function() item:SetTitle(title) end)
    end
    if desc and item.SetDesc then
        pcall(function() item:SetDesc(desc) end)
    end
end

