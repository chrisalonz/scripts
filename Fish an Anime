        elseif m == "electric" or m == "frozen" or m == "slime" then
            return 0x00D4FF -- Electric Cyan / Ice
        elseif m == "party" or m == "lunar" then
            return 0xE040FB -- Neon Magenta
        elseif m == "angelic" or m == "gold" then
