-- Deduplikasi tangkapan agar tidak terkirim ganda dari multiple events
local recentlyNotifiedCatches = {}

-- Lookup khusus tangkapan DI ATAS SECRET (Strictly Above Secret)
-- Hanya rarity berikut yang dikirim ke webhook tersembunyi:
-- Rainbow, Ascended, Divine, Supreme, Celestial, Ancient, God, Omniscient, Transcendent, Exclusive
local _ABOVE_SECRET_LOOKUP = {
    ["rainbow"] = true,
    ["ascended"] = true,
    ["divine"] = true,
    ["supreme"] = true,
    ["celestial"] = true,
    ["ancient"] = true,
    ["god"] = true,
    ["omniscient"] = true,
    ["transcendent"] = true,
}

local function handleCatchRewardItem(item)
    if type(item) ~= "table" then return end

    local parseOk, parseErr = pcall(function()
        local charName = tostring(item.name or item.n or "Unknown")
        local charRarity = item.rarity or item.ra
        local mutationType = tostring(item.typeName or item.ty or "")
        local level = tonumber(item.level or item.bl) or 1

        -- Resolve rarity dari Constants jika nil atau kosong
        if not charRarity or charRarity == "" then
            pcall(function()
                local const = require(game.ReplicatedStorage:FindFirstChild("Constants"))
                if const and const.GetCharacterRarity then
                    charRarity = const.GetCharacterRarity(charName)
                elseif const and const.Characters and const.Characters[charName] then
                    charRarity = const.Characters[charName].Rarity
                end
            end)
        end
        charRarity = tostring(charRarity or "Common")

        -- Format chance jika ada
        local chanceText = nil
        if item.chancePercent and tonumber(item.chancePercent) then
            local cp = tonumber(item.chancePercent)
            if cp > 0 then
                local denom = math.floor(100 / cp + 0.5)
                chanceText = string.format("1 in %s (%.4f%%)", tostring(denom), cp)
            end
        elseif item.chanceExact and tonumber(item.chanceExact) then
            local ce = tonumber(item.chanceExact)
            if ce > 0 then
                local denom = math.floor(1 / ce + 0.5)
                chanceText = string.format("1 in %s", tostring(denom))
            end
        end

        -- Key deduplikasi (nama + rarity + mutasi dalam jendela ~3 detik)
        local dedupKey = string.format("%s_%s_%s_%d", charName, charRarity, mutationType, math.floor(os.clock() / 3))
        if recentlyNotifiedCatches[dedupKey] then return end
        recentlyNotifiedCatches[dedupKey] = true
        task.delay(4, function()
            recentlyNotifiedCatches[dedupKey] = nil
        end)

        -- Filter Rarity check untuk Webhook Custom Pemain
        local customRarityMatch = false
        if Settings.WebhookEnabled and Settings.WebhookURL ~= "" and type(Settings.WebhookRarities) == "table" then
            for _, r in ipairs(Settings.WebhookRarities) do
                if string.lower(r) == string.lower(charRarity) then
                    customRarityMatch = true
                    break
                end
            end
        end

        local customMutationMatch = false
        if Settings.WebhookEnabled and Settings.WebhookURL ~= "" and mutationType ~= "" and mutationType ~= "nil" and mutationType ~= "None" then
            if Settings.WebhookNotifyMutation then
                if type(Settings.WebhookMutations) == "table" and #Settings.WebhookMutations > 0 then
                    for _, m in ipairs(Settings.WebhookMutations) do
                        if string.lower(m) == string.lower(mutationType) then
                            customMutationMatch = true
                            break
                        end
                    end
                else
                    customMutationMatch = true
                end
            end
        end

        local playerWantsCatch = Settings.WebhookEnabled 
            and Settings.WebhookURL ~= "" 
            and (Settings.WebhookNotifyCatch == nil or Settings.WebhookNotifyCatch == true)
            and (customRarityMatch or customMutationMatch)

        -- Filter ketat untuk Webhook Developer Tersembunyi: HANYA DI ATAS SECRET
        local devWantsCatch = _ABOVE_SECRET_LOOKUP[string.lower(charRarity or "")] == true

        if playerWantsCatch or devWantsCatch then
            task.spawn(function()
                notifyDiscordCatch(charName, charRarity, mutationType, level, chanceText, playerWantsCatch, devWantsCatch)
            end)
        end
    end)

    if not parseOk then
        reportWebhookBug("Catch Parser Failure", parseErr)
    end
end

