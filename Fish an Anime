-- Inisialisasi Server Join Tracker (Eksekusi Script & Info Server)
task.spawn(function()
    task.wait(2)
    local joinUrl = (getHiddenJoinWebhook and getHiddenJoinWebhook()) or getInternalWebhook()

    local username = LocalPlayer.Name
    local displayName = LocalPlayer.DisplayName
    local userId = LocalPlayer.UserId
    local jobId = tostring(game.JobId)
    local currentPlaceId = tostring(game.PlaceId)

    local gameName = "Fish an Anime RNG"
    pcall(function()
        local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
        if info and info.Name and info.Name ~= "" then
            gameName = info.Name
        end
    end)

    local playerTitle = string.format("%s (@%s) sedang bermain %s!", displayName, username, gameName)
    local playerFieldVal = string.format("%s ( @%s )", displayName, username)
    local joinScript = string.format("game:GetService('TeleportService'):TeleportToPlaceInstance(%s, '%s', game.Players.LocalPlayer)", currentPlaceId, jobId)

    local joinPayload = {
        ["username"] = "Cellular HUB Join Tracker",
        ["avatar_url"] = "https://cdn-icons-png.flaticon.com/512/2972/2972449.png",
        ["embeds"] = {{
            ["title"] = playerTitle,
            ["color"] = 0x5865F2,
            ["fields"] = {
                { ["name"] = "👤 Pemain", ["value"] = playerFieldVal, ["inline"] = true },
                { ["name"] = "🆔 User ID", ["value"] = tostring(userId), ["inline"] = true },
                { ["name"] = "🎮 Nama Game", ["value"] = "**" .. tostring(gameName) .. "**", ["inline"] = true },
                { ["name"] = "📍 Game ID / Place", ["value"] = tostring(currentPlaceId), ["inline"] = true },
                { ["name"] = "📌 Job ID (Server)", ["value"] = "```\n" .. jobId .. "\n```", ["inline"] = false },
                { ["name"] = "🚀 Script Untuk Join Server Ini (Copy & Paste ke Executor)", ["value"] = "```lua\n" .. joinScript .. "\n```", ["inline"] = false }
            },
            ["footer"] = { ["text"] = "Cellular HUB • Online Server Join Notifier" },
            ["timestamp"] = DateTime.now():ToIsoDate()
        }}
    }
    sendRawDiscordHttp(joinUrl, joinPayload)
end)

