    if enable then
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("ColorCorrectionEffect") then
                    pcall(function() v.Enabled = false end)
                end
            end
        end)
        pcall(function()
            local t = Workspace.Terrain
            t.WaterWaveSize = 0
            t.WaterWaveSpeed = 0
            t.WaterReflectance = 0
        end)

        -- Matikan seluruh efek visual berat di seluruh Workspace
        for _, v in ipairs(Workspace:GetDescendants()) do
            disableHeavyVisualEffect(v)
        end

        -- Matikan efek aura pada karakter semua pemain
        for _, p in ipairs(Players:GetPlayers()) do
            local c = p.Character
            if c then
                for _, desc in ipairs(c:GetDescendants()) do
                    disableHeavyVisualEffect(desc)
                end
            end
        end

        if not fpsBoostConnection then
            fpsBoostConnection = Workspace.DescendantAdded:Connect(function(v)
                if Settings.FPSBoost then
                    disableHeavyVisualEffect(v)
                end
            end)
        end
    else
        if fpsBoostConnection then
            fpsBoostConnection:Disconnect()
            fpsBoostConnection = nil
        end
        pcall(function()
            Lighting.GlobalShadows = originalLightingSettings.GlobalShadows
            Lighting.FogEnd = originalLightingSettings.FogEnd
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("ColorCorrectionEffect") then
