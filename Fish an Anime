local function shouldNotifyEvent(eventName)
    if not Settings.WebhookEventsFilter or #Settings.WebhookEventsFilter == 0 then return true end
    for _, filter in ipairs(Settings.WebhookEventsFilter) do
        if filter == "All Events" or string.find(string.lower(eventName), string.lower(filter)) then
            return true
        end
    end
    return false
end

local lastNotifiedEvent = ""
local lastNotifiedEventTime = 0

local function handleServerEventTrigger(eventName, eventTitle, eventDesc, durationSec)
    local now = os.clock()
    if lastNotifiedEvent == eventName and (now - lastNotifiedEventTime) < 30 then
        return
    end
    lastNotifiedEvent = eventName
    lastNotifiedEventTime = now

    if shouldNotifyEvent(eventName) or shouldNotifyEvent(eventTitle) then
        notifyDiscordEvent(eventTitle, eventDesc, durationSec)
    end
end

