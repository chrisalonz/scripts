            head.Text = "Selected (" .. tostring(countSelected()) .. "/" .. tostring(#options) .. ")  " .. (isOpen and "▲" or "▼")
        end
        updateHeadText()

        local function setMultiDropdownOpen(open)
            isOpen = open
            updateHeadText()
            if isOpen then
                listFrame.Visible = true
                TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, 0, 0, 62 + listHeight + 8)
                }):Play()
            else
                local tween = TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(1, 0, 0, 62)
                })
                tween:Play()
                task.delay(0.2, function()
                    if not isOpen then
                        listFrame.Visible = false
                    end
                end)
            end
        end

        head.MouseButton1Click:Connect(function()
            setMultiDropdownOpen(not isOpen)
        end)

        for _, opt in ipairs(options) do
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, 0, 0, 28)
            optBtn.BackgroundTransparency = 1
            optBtn.Font = Enum.Font.GothamSemibold
            optBtn.TextSize = 12
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.ZIndex = 51
            optBtn.Parent = listFrame
            RegisterThemeElement(optBtn, "TextColor3", "TextPrimary")

            local p = Instance.new("UIPadding")
            p.PaddingLeft = UDim.new(0, 10)
            p.Parent = optBtn

            local function updateOptText()
                local isChecked = selectedMap[opt] == true
                optBtn.Text = (isChecked and "[✓] " or "[   ] ") .. tostring(opt)
            end
            updateOptText()

            optBtn.MouseButton1Click:Connect(function()
                if selectedMap[opt] then
                    selectedMap[opt] = nil
                else
                    selectedMap[opt] = true
                end
                updateOptText()
                updateHeadText()
                local resList = {}
                for k in pairs(selectedMap) do table.insert(resList, k) end
                if callback then callback(resList) end
                RequestAutoSave()
            end)
        end
    end

