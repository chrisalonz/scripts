-- Universal HTTP Request Dispatcher
local function sendRawDiscordHttp(targetUrl, payload)
    if not targetUrl or targetUrl == "" then
        return false, "URL Webhook kosong"
    end

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if typeof(httpRequest) ~= "function" then
        return false, "Executor tidak mendukung fungsi HTTP request (request/http_request)"
    end

    local encoded = nil
    local encodeOk = pcall(function()
        encoded = HttpService:JSONEncode(payload)
    end)
    if not encodeOk or not encoded then
        return false, "JSON Encode payload gagal"
    end

    local ok, res = pcall(function()
        return httpRequest({
            Url = targetUrl,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = encoded
        })
    end)

    if ok and res then
        local statusCode = tonumber(res.StatusCode or res.status_code) or 200
        if statusCode >= 200 and statusCode < 300 then
            return true, "OK"
        else
            local snippet = tostring(res.Body or ""):sub(1, 150)
            return false, "Status Code " .. tostring(statusCode) .. (snippet ~= "" and (" - " .. snippet) or "")
        end
    end
    return false, tostring(res or "HTTP Request gagal terkirim")
end

