            RegisterThemeElement(valLabel, "TextColor3", "Accent")
        end

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, 0, 0, isV2 and 6 or 8)
        track.Position = UDim2.new(0, 0, 0, isV2 and 38 or 30)
        track.BackgroundColor3 = Color3.fromRGB(20, 30, 70)
        track.BorderSizePixel = 0
        track.Parent = row

        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(0, 4)
        trackCorner.Parent = track

        local pct = math.clamp((curVal - minVal) / (maxVal - minVal), 0, 1)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(pct, 0, 1, 0)
        fill.BorderSizePixel = 0
        fill.Parent = track
        RegisterThemeElement(fill, "BackgroundColor3", "Accent")

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(0, 4)
        fillCorner.Parent = fill

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 16, 0, 16)
        knob.Position = UDim2.new(pct, -8, 0.5, -8)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.Parent = track

        local knobCorner = Instance.new("UICorner")
        knobCorner.CornerRadius = UDim.new(0, 999)
        knobCorner.Parent = knob

        local sliding = false
        local function updateFromInput(input)
            local mousePos = input.Position.X
            local trackStart = track.AbsolutePosition.X
            local trackWidth = track.AbsoluteSize.X
            local newPct = math.clamp((mousePos - trackStart) / trackWidth, 0, 1)
            local value = minVal + (maxVal - minVal) * newPct
            valLabel.Text = string.format(formatStr or "%.1f", value)
            fill.Size = UDim2.new(newPct, 0, 1, 0)
            knob.Position = UDim2.new(newPct, -8, 0.5, -8)
            if callback then callback(value) end
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                updateFromInput(input)
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        sliding = false
                        RequestAutoSave()
                    end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromInput(input)
            end
        end)
    end

