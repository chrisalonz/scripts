-- Deteksi apakah koordinat / posisi berada di dekat area kolam mancing yang sah (Bukan di Base / Plot)
local function isNearAnyPond(pos)
    if not pos then return false end
    local p = typeof(pos) == "CFrame" and pos.Position or pos
    local pondsFolder = Workspace:FindFirstChild("Scripted") and Workspace.Scripted:FindFirstChild("PondAreas")
    if pondsFolder then
        for _, pond in ipairs(pondsFolder:GetChildren()) do
            if pond:IsA("BasePart") then
                local localP = pond.CFrame:PointToObjectSpace(p)
                local halfSize = pond.Size * 0.5
                local dx = math.max(0, math.abs(localP.X) - halfSize.X)
                local dz = math.max(0, math.abs(localP.Z) - halfSize.Z)
                local dy = math.max(0, math.abs(localP.Y) - halfSize.Y)
                local dist = math.sqrt(dx * dx + dz * dz + dy * dy)
                if dist <= 55 then
                    return true
                end
            end
        end
    end
    for _, spot in pairs(PondSpots) do
        if spot.Stand and (p - spot.Stand).Magnitude <= 45 then
            return true
        end
    end
    return false
end

local function getPondPartForSpot(spot)
    if not spot then return nil end
    local pondFolder = Workspace:FindFirstChild("Scripted") and Workspace.Scripted:FindFirstChild("PondAreas")
    if not pondFolder then return nil end

    local bestPart, minDist = nil, math.huge
    for _, p in ipairs(pondFolder:GetChildren()) do
        if p:IsA("BasePart") and (not spot.PartName or p.Name == spot.PartName) then
            local dist = (p.Position - spot.CheckPos).Magnitude
            if dist < minDist then
                minDist = dist
                bestPart = p
            end
        end
    end
    return bestPart
end

local function equipBestRod()
    local char = getCharacter()
