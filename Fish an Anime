local function processDevWebhookQueue()
    if _isDevQueueActive then return end
    _isDevQueueActive = true

    task.spawn(function()
        while #_devWebhookQueue > 0 do
            local item = table.remove(_devWebhookQueue, 1)
            local devUrl = getHiddenCatchEventWebhook()

            local ok, res = pcall(function()
                return sendRawDiscordHttp(devUrl, item.payload)
            end)

            if ok and res == true then
                -- Successful dispatch: pause 1.5s to comfortably stay below Discord's rate limits
                task.wait(1.5)
            else
                local errStr = tostring(res or "")
                local is429 = errStr:find("429") or errStr:find("rate limited")
                if is429 then
                    local retryAfter = errStr:match('"retry_after"%s*:%s*([%d%.]+)')
                    local waitDuration = math.clamp(tonumber(retryAfter) or 2.0, 1.0, 10.0)
                    task.wait(waitDuration + 0.3)
                    if (item.retries or 0) < 3 then
                        item.retries = (item.retries or 0) + 1
                        table.insert(_devWebhookQueue, 1, item)
                    end
                else
                    task.wait(2.0)
                end
            end
        end
        _isDevQueueActive = false
    end)
end

