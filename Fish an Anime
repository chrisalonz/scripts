-- AUTO COLLECT EVENT GEMS LOGIC (HEAVEN COLLIDE & EVENT GEMS)
-- ==============================================================================
local isCollectingGems = false

local function collectSingleGem(gem, method, character)
    if not gem or not gem.Parent then return false end
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local gemPart = gem:IsA("BasePart") and gem or (gem:IsA("Model") and (gem.PrimaryPart or gem:FindFirstChildWhichIsA("BasePart")))
    if not gemPart then return false end

    -- firetouchinterest mengeksekusi packet touch secara langsung tanpa perlu memindahkan fisik karakter ke langit/void
    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, gemPart, 0)
            task.wait(0.01)
            firetouchinterest(root, gemPart, 1)
        end)
        return true
    end
    return false
end

local function collectAllEventGems(method)
    if isCollectingGems then return 0 end
    isCollectingGems = true

    local character = getCharacter()
    local root = getRoot()
    if not root then
        isCollectingGems = false
        return 0
    end

    local gems = CollectionService:GetTagged("EventGemHover")
    if #gems == 0 then
        isCollectingGems = false
        return 0
    end

    -- Pastikan posisi awal memancing hanya dicatat jika berada di dekat kolam (bukan di plot)
    if root and isNearAnyPond(root.Position) then
        HeavenFarmingState.lastFishingCFrame = root.CFrame
    end

    local savedCFrame = (HeavenFarmingState.lastFishingCFrame and isNearAnyPond(HeavenFarmingState.lastFishingCFrame.Position) and HeavenFarmingState.lastFishingCFrame) or root.CFrame
    local collectedCount = 0

    -- Ambil seluruh permata via firetouchinterest super cepat & aman tanpa memindahkan tubuh karakter ke udara/void
    for _, gem in ipairs(gems) do
        if gem and gem.Parent and character and character.Parent then
            local gemPart = gem:IsA("BasePart") and gem or (gem:IsA("Model") and (gem.PrimaryPart or gem:FindFirstChildWhichIsA("BasePart")))
            if gemPart and firetouchinterest then
                pcall(function()
                    firetouchinterest(root, gemPart, 0)
                    task.wait(0.01)
                    firetouchinterest(root, gemPart, 1)
                end)
                collectedCount = collectedCount + 1
                task.wait(0.015)
            end
        end
    end

    -- Kunci kembali koordinat ke posisi mancing yang valid
    if root and root.Parent then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if savedCFrame and isNearAnyPond(savedCFrame.Position) then
                root.CFrame = savedCFrame
            end
        end)
    end

    isCollectingGems = false
    return collectedCount
end

local function resumeFishingAfterGems()
    if HeavenFarmingState.isReturning then return end
    HeavenFarmingState.isReturning = true

    local char = getCharacter()
    local root = getRoot()
    local hum = getHumanoid()

    if not char or not root or (hum and hum.Health <= 0) then
        HeavenFarmingState.isReturning = false
        return
    end

    -- 1. Kembalikan karakter LANGSUNG ke pinggir kolam yang dipilih di menu (bebas dari plot)
    local chosenSpot = PondSpots[Settings.SelectedPond] or PondSpots["Main Pond (Pusat)"]
    if chosenSpot and chosenSpot.Stand then
        teleportTo(chosenSpot.Stand)
        task.wait(0.35)
        HeavenFarmingState.lastFishingCFrame = root.CFrame
    elseif HeavenFarmingState.lastFishingCFrame and isNearAnyPond(HeavenFarmingState.lastFishingCFrame.Position) then
        teleportTo(HeavenFarmingState.lastFishingCFrame)
        task.wait(0.3)
    end

